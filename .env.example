# AI provider: "auto" uses your ChatGPT plan through the signed-in Codex CLI (`codex login`)
# and falls back to OPENAI_API_KEY. Force one with "codex" or "api".
WARDROBE_AI_PROVIDER=auto
OPENAI_API_KEY=

# Each task uses the newest version of the smallest model tier that does it well, not the biggest model:
# terra for finding clothes and planning outfits, luna for driving image generation.
# Uncomment to pin API models instead.
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_VISION_MODEL=gpt-6.1-terra
# OPENAI_PLANNER_MODEL=gpt-6.1-terra
OPENAI_IMAGE_QUALITY=high

# Pin the image model for one stage only (otherwise OPENAI_IMAGE_MODEL / the newest gpt-image).
# OPENAI_GARMENT_MODEL=
# OPENAI_MODELED_MODEL=
# Another OpenAI-compatible endpoint.
# OPENAI_API_BASE_URL=https://api.openai.com/v1

# Codex: force one model for every task, and the reasoning effort.
# CODEX_MODEL=gpt-6.1-terra
# CODEX_REASONING_EFFORT=low
# The stylist's reasoning effort on Codex (it is worth more thought than the other tasks).
# PLANNER_REASONING_EFFORT=medium
# Where the codex binary and its home (sign-in, model list, generated images) are.
# CODEX_BIN=codex
# CODEX_HOME=   (defaults to ~/.codex)

# How many image generations (cutouts, try-ons) run at once; the rest wait in line.
# WARDROBE_AI_CONCURRENCY=2
# Where the wardrobe, plans and images are stored.
# WARDROBE_DATA_DIR=data

# Add a PNG at data/model-reference.png or point to another local file.
WARDROBE_MODEL_REFERENCE=data/model-reference.png
